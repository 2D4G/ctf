-u http://TARGET/FUZZ \
-w /usr/share/wordlists/dirb/common.txt \
-e .php,.html,.txt,.bak,.old,.zip,.json,.conf


# Важно:
# Смотреть на STATUS, SIZE, WORDS.
# Если приложение возвращает одинаковую страницу 200 для
