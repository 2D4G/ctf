====================================================================
0. ПОДГОТОВКА
====================================================================

# Создаем рабочий каталог.

mkdir -p ~/pentest/{recon,nmap,web,smb,ldap,snmp,vuln,creds,loot,flags,notes}

# targets.txt содержит ТОЛЬКО разрешенные IP.

nano ~/pentest/targets.txt


Пример:

10.10.10.10
10.10.10.20
10.10.10.30


# Переходим в каталог.

cd ~/pentest


====================================================================
1. БЫСТРАЯ РАЗВЕДКА
====================================================================

# Проверка доступности IP.

nmap -sn -iL targets.txt -oA recon/host_discovery

# -sn = host discovery без port scan
# -iL = взять список IP из файла
# -oA = сохранить результаты в трех форматах:
#       .nmap
#       .xml
#       .gnmap


# Если ICMP блокируется:

nmap -Pn -iL targets.txt -oA recon/hosts_no_ping

# -Pn = считать хост активным, даже если ping не отвечает.


====================================================================
2. БЫСТРЫЙ TCP PORT SCAN
====================================================================

# Быстро проверить наиболее распространенные TCP-порты.

nmap -Pn --top-ports 1000 -iL targets.txt \
-oA nmap/top1000


# Полный TCP scan всех 65535 портов.

nmap -Pn -p- --min-rate 2000 -iL targets.txt \
-oA nmap/all_tcp


# Если сеть нестабильная — убрать --min-rate.

nmap -Pn -p- -iL targets.txt \
-oA nmap/all_tcp_safe


# -p- = все TCP порты
# -Pn = не делать ping discovery
# --min-rate = минимальная скорость отправки пакетов


====================================================================
3. ГЛУБОКОЕ ОПРЕДЕЛЕНИЕ СЕРВИСОВ
====================================================================

# После обнаружения открытых портов:

nmap -Pn -sC -sV -p- TARGET \
-oA nmap/TARGET_full


# -sC = стандартные безопасные NSE scripts
# -sV = определение версии сервисов


# Определение ОС:

sudo nmap -Pn -O TARGET \
-oA nmap/TARGET_os


# Более глубокий вариант:

sudo nmap -Pn -A TARGET \
-oA nmap/TARGET_aggressive


# -A включает:
# OS detection
# version detection
# scripts
# traceroute


====================================================================
